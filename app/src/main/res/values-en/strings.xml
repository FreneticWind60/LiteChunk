    <string name="activity_about_01">About</string>
    <string name="activity_about_02">Move saves between Java and Bedrock Edition</string>
    <string name="activity_about_03">What it is</string>
    <string name="activity_about_04">LiteChunk is a small Minecraft world converter built on the open source Chunker engine. It does one thing — moving a save between Java and Bedrock Edition — so the interface, the download size and the idle footprint all stay as small as possible.</string>
    <string name="activity_about_05">· Every Java and Bedrock version, both directions\n· Batch conversion with live progress, cancellable at any time\n· Conversion runs in its own process, so a huge world cannot take the UI down with it\n· Finished .mcworld / .zip files land in the output folder, ready to export, share, or open straight in the game</string>
    <string name="activity_about_06">Check for updates</string>
    <string name="activity_about_07">Ask GitHub for the latest release</string>
    <string name="activity_about_08">Check</string>
    <string name="activity_about_09">Developer</string>
    <string name="activity_about_10">An independent developer building save tools and small utilities, filling in a few of the holes in Minecraft\'s version migration along the way.</string>
    <string name="activity_about_11">Bilibili</string>
    <string name="activity_about_12">Licence</string>
    <string name="activity_about_13">LiteChunk is released under the MIT licence and converts with Chunker. You may use, modify and redistribute it freely, as long as derivative works keep the original copyright and licence notice.</string>
    <string name="activity_about_14">Not affiliated with, endorsed by or authorised by Mojang Studios or Microsoft. Minecraft is a trademark of Mojang Studios. This app ships no game assets and does not modify the game itself; please back up any save you convert.</string>
    <string name="activity_about_15">Back</string>

    <string name="activity_level_01">Save details</string>
    <string name="activity_level_02">Findings</string>
    <string name="activity_level_03">level.dat</string>
    <string name="activity_level_04">Grey rows are read-only. Saving rewrites level.dat only — blocks are never re-encoded, which is why it is far faster than a conversion and why unknown blocks cannot turn into placeholders. An overwrite cannot be undone; use Save as to keep the original. The world type is preserved: a superflat world stays flat, a normal one stays infinite.</string>
    <string name="activity_level_05">Back</string>

