<?xml version="1.0" encoding="utf-8"?>
<!--
    Target version picker: one section per major version, its patch versions as chips. The whole thing scrolls, because
    a Java group runs from 1.8 to 26.x and a flat list of eighty rows was unreadable.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollVersions"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxHeight="520dp"
    android:paddingStart="20dp"
    android:paddingTop="4dp"
    android:paddingEnd="20dp"
    android:paddingBottom="8dp"
    android:scrollbars="vertical">

    <LinearLayout
        android:id="@+id/listVersions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:chipSpacingVertical="0dp" />
</ScrollView>
