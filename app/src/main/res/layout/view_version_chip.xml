<?xml version="1.0" encoding="utf-8"?>
<!--
    One target version. Inflated rather than built in code so the Material style, the touch target and the
    checked state come from the theme instead of being repeated as attributes.
-->
<com.google.android.material.chip.Chip xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Material3.Chip.Filter"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:checkable="true"
    android:clickable="true"
    android:focusable="true"
    app:chipMinTouchTargetSize="40dp" />
