<?xml version="1.0" encoding="utf-8"?>
<!--
    The export choice for a Bedrock save. A custom popup rather than a PopupMenu because the two entries are
    genuinely different formats to the user — one goes to a launcher, one goes to the game — and an icon says that
    faster than two lines of text that differ by four characters.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_popup"
    android:orientation="vertical"
    android:padding="6dp">

    <LinearLayout
        android:id="@+id/itemZip"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:background="@drawable/bg_popup_item"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minWidth="188dp"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="16dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_zip"
            app:tint="@color/accent_alt" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="导出为 .zip"
            android:textColor="@color/text"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/itemMcworld"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="2dp"
        android:background="@drawable/bg_popup_item"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minWidth="188dp"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="16dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_bedrock"
            app:tint="@color/accent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="导出为 .mcworld"
            android:textColor="@color/text"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="游戏可导入"
            android:textColor="@color/text_faint"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
