<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- The about page checks GitHub for a newer release. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        Package visibility (API 30+): without these entries getPackageInfo() always throws, so "is Minecraft Bedrock
        installed?" would answer no on every device and every import would silently fall back to sharing.
    -->
    <queries>
        <package android:name="com.mojang.minecraftpe" />
        <package android:name="net.kdt.pojavlaunch" />
        <package android:name="com.tungsten.fcl" />
        <package android:name="com.tungsten.fclauncher" />
        <package android:name="com.boat.launcher" />
        <package android:name="com.mio.launcher" />
        <package android:name="com.angnesss.amethyst" />
    </queries>

    <application
        android:name=".LiteChunkApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.LiteChunk">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Conversion runs in its own process: a second heap budget, a crash boundary and a hard cancel. -->
        <service
            android:name=".ConversionService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:process=":chunker" />

        <activity
            android:name=".AboutActivity"
            android:exported="false"
            android:label="@string/action_about"
            android:parentActivityName=".MainActivity"
            android:screenOrientation="portrait" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
