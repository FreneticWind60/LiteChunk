<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- The about page checks GitHub for a newer release. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!--
        A conversion is a foreground service, which buys "don't kill me" but not "don't suspend the CPU": with the
        screen off the device suspends and the worker simply stops mid-region. The partial wake lock is held only
        while a conversion is running and released in the same `finally` block that stops the notification.
    -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!--
        Used to open the system "ignore battery optimisations" dialog once, on the first conversion. OEMs freeze
        background apps regardless of the foreground service state, and a frozen worker looks exactly like a hung
        one. This app is not distributed through Play, so no policy stake.
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!--
        Package visibility (API 30+): without these entries getPackageInfo() always throws, so "is Minecraft Bedrock
        installed?" would answer no on every device and every import would silently fall back to sharing.
    -->
    <queries>
        <package android:name="com.mojang.minecraftpe" />
        <package android:name="net.kdt.pojavlaunch" />
        <package android:name="com.tungsten.fcl" />
        <package android:name="com.tungsten.fclauncher" />
        <package android:name="com.boat.launcher" />
        <package android:name="com.mio.launcher" />
        <package android:name="com.angnesss.amethyst" />
    </queries>

    <application
        android:name=".LiteChunkApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.LiteChunk">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            A second entry point for archives coming from other apps, so the share sheet says what it does
            ("导入到 LiteChunk") instead of reusing the launcher label, and so the icon can differ later.

            The mime list is deliberately broad. WeChat, QQ and most file managers report an unknown extension as
            application/octet-stream, and browsers often as */*, so anything narrower simply never appears in their
            "open with" sheet. The breadth is paid for in code: Inbox.isArchive() rejects everything that is not a
            .zip / .mcworld before a single byte is copied.
        -->
        <activity-alias
            android:name=".ImportActivity"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/import_label"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity-alias>

        <!-- Conversion runs in its own process: a second heap budget, a crash boundary and a hard cancel. -->
        <service
            android:name=".ConversionService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:process=":chunker" />

        <activity
            android:name=".AboutActivity"
            android:exported="false"
            android:label="@string/action_about"
            android:parentActivityName=".MainActivity"
            android:screenOrientation="portrait" />

        <!-- Reads and rewrites level.dat. Not exported: worlds only come from this app's own output folder. -->
        <activity
            android:name=".LevelActivity"
            android:exported="false"
            android:label="@string/action_details"
            android:parentActivityName=".MainActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
